# HookSwap per-chain RPC config  (COMMITTED TEMPLATE — placeholders only, NO real keys)
#
# Copy to  config/rpc.env  (gitignored) and fill the real Infura key, then `source` it (or
# pass via docker --env-file) alongside .env when running the adapter and/or routing-api.
#
# Convention: WEB3_RPC_<chainId>  — this is what BOTH the routing-api fork and this adapter's
# embed-SOR mode read (see src/chains.ts `rpcEnvVar`, and routing-api/hookswap/README.md §1).
#
# WHICH PROVIDER SERVES WHICH CHAIN
# --------------------------------------------------------------------------------------------
#   Infura serves Ethereum + Sepolia + major L2s, but NOT the HookSwap custom chains
#   (MegaETH/Robinhood/Ink/XLayer/HyperEVM/Tempo are too niche for Infura/Alchemy/QuickNode).
#   So: Sepolia (+ optional mainnet) => Infura;  the 6 custom chains => their PUBLIC RPCs,
#   which you should replace with a dedicated/self-run node when traffic justifies it.
#
#   Get an Infura key at https://app.infura.io  → replace <INFURA_KEY> below.

# --- Infura-served (dedicated) ---
WEB3_RPC_11155111=https://sepolia.infura.io/v3/<INFURA_KEY>          # Sepolia (testing)
# WEB3_RPC_1=https://mainnet.infura.io/v3/<INFURA_KEY>               # Ethereum mainnet (only if needed)

# --- Custom HookSwap chains: PUBLIC RPCs (replace with dedicated node when available) ---
WEB3_RPC_4326=https://mainnet.megaeth.com/rpc                        # MegaETH  — TODO dedicated node
WEB3_RPC_4663=https://rpc.mainnet.chain.robinhood.com                # Robinhood — TODO dedicated node
WEB3_RPC_57073=https://rpc-gel.inkonchain.com                        # Ink      — TODO dedicated node
WEB3_RPC_196=https://xlayer.drpc.org                                 # XLayer   — TODO dedicated node
WEB3_RPC_999=https://rpc.hyperliquid.xyz/evm                         # HyperEVM — TODO dedicated node
WEB3_RPC_4217=https://rpc.tempo.xyz                                  # Tempo    — TODO dedicated node
