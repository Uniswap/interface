# HookSwap Trading API adapter — service env (copy to .env, DO NOT commit real values)
# The adapter itself only needs to know how to reach the routing backend + CORS origin.
# Per-chain RPC URLs live in config/rpc.example.env (the routing-api / embed-SOR reads those).

# --- Routing backend selection ---
# PROXY mode (recommended for now): URL of the DEPLOYED HooksOS/routing-api stage.
#   e.g. https://abc123.execute-api.us-east-1.amazonaws.com/prod
# If unset, the adapter returns a proper Trading-API 404 (NO fabricated quotes).
ROUTING_API_URL=

# EMBED mode (in-process SOR): set to "embed" only after implementing EmbedRoutingProvider
# (see src/routingClient.ts). Leave blank to use PROXY mode.
ROUTING_MODE=

# --- HTTP host ---
PORT=4000
# Origin allowed to call this adapter from the browser. Set to the interface origin in prod,
# e.g. https://hookswap.org  (use http://localhost:3000 for local interface dev).
CORS_ALLOW_ORIGIN=http://localhost:3000
