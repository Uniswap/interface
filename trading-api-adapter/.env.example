# HookSwap Trading API adapter — service env (copy to .env, DO NOT commit real values)
# The adapter itself only needs to know how to reach the routing backend + CORS origin.
# Per-chain RPC URLs live in config/rpc.example.env (the routing-api / embed-SOR reads those).

# --- Routing backend selection ---
# EMBED mode (recommended, in-process SOR): runs AlphaRouter in-process (see
# src/embedRouter.ts — IMPLEMENTED). This is the default deploy mode per the infra
# decision (embed the HooksOS smart-order-router rather than proxy an AWS routing-api).
# Requires the SOR fork deps installed (npm install) + per-chain RPC (config/rpc.env).
ROUTING_MODE=embed

# PROXY mode (alternative): set ROUTING_MODE= (blank) and point this at a DEPLOYED
# HooksOS/routing-api stage instead. Used only when ROUTING_MODE is not "embed".
#   e.g. https://abc123.execute-api.us-east-1.amazonaws.com/prod
# NOTE: if ROUTING_MODE is blank AND this is empty, the adapter returns a proper
# Trading-API 404 (NO fabricated quotes) — every quote will fail. Set one of them.
ROUTING_API_URL=

# --- HTTP host ---
PORT=4000
# Origin allowed to call this adapter from the browser. Set to the interface origin in prod,
# e.g. https://hookswap.org  (use http://localhost:3000 for local interface dev).
CORS_ALLOW_ORIGIN=http://localhost:3000
