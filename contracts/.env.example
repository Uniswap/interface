# ---------------------------------------------------------------------------
# HookSwap contract deploy kit — environment template
# Copy this file to `.env` and fill in the values. NEVER commit your real .env.
#   cp .env.example .env
# ---------------------------------------------------------------------------

# Funded deployer private key (hex, WITH or WITHOUT the 0x prefix — forge/cast
# accept both). This account pays gas on every chain, so fund it on each one
# you intend to deploy to. Treat as a secret.
DEPLOYER_PRIVATE_KEY=

# ---------------------------------------------------------------------------
# Per-chain RPC endpoints. Override with your own (Alchemy/Infura/self-hosted)
# for reliability — the public defaults below rate-limit aggressively.
# ---------------------------------------------------------------------------

# Sepolia testnet (chainId 11155111)
SEPOLIA_RPC_URL=https://rpc.sepolia.org

# HyperEVM mainnet (chainId 999)
HYPEREVM_RPC_URL=https://rpc.hyperliquid.xyz/evm

# Robinhood Chain mainnet (chainId 4663)
ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com

# ---------------------------------------------------------------------------
# Optional: Etherscan (or compatible explorer) API key used by `forge verify`.
# Only Sepolia has a first-class Etherscan today; HyperEVM / Robinhood
# verification depends on their explorer supporting the Etherscan API.
# Leave blank to skip verification.
# ---------------------------------------------------------------------------
ETHERSCAN_API_KEY=
