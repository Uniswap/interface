{
  "boundaries": [
    {
      "id": "toucan-feature",
      "mode": "importerAllowlist",
      "importerInternalPathMarkers": ["/features/Toucan/"],
      "allowedImporterPathMarkers": [
        "/pages/Explore/",
        "/features/Explore/state",
        "/pages/Launches/",
        "/pages/Liquidity/CreateAuction/",
        "/pages/TokenDetails/"
      ],
      "importPrefixes": ["~/features/Toucan/", "features/Toucan/"],
      "bareModuleSources": ["~/features/Toucan", "features/Toucan"],
      "message": "Toucan feature code may only be imported from pages/Explore/, features/explore/state, pages/Launches/, pages/Liquidity/CreateAuction/, pages/TokenDetails/, or from within features/Toucan/."
    },
    {
      "id": "liquidity-feature",
      "mode": "importerAllowlist",
      "importerInternalPathMarkers": ["/features/Liquidity/"],
      "allowedImporterPathMarkers": [
        "/pages/AddLiquidity/",
        "/pages/CreatePosition/",
        "/pages/Explore/",
        "/pages/IncreaseLiquidity/",
        "/pages/LegacyPool/",
        "/pages/Liquidity/",
        "/pages/Migrate/",
        "/pages/PoolDetails/",
        "/pages/Portfolio/",
        "/pages/Positions/",
        "/pages/RemoveLiquidity/",
        "/app/layout/TopLevelModals/"
      ],
      "importPrefixes": ["~/features/Liquidity/", "features/Liquidity/"],
      "bareModuleSources": ["~/features/Liquidity", "features/Liquidity"],
      "message": "Liquidity feature code may only be imported from the allowlisted page routes, D3LiquidityChartShared, TopLevelModals, or from within features/Liquidity/"
    },
    {
      "id": "swap-feature",
      "mode": "importerAllowlist",
      "importerInternalPathMarkers": ["/features/Swap/"],
      "allowedImporterPathMarkers": [
        "/pages/Swap/",
        "/pages/TokenDetails/",
        "/pages/Landing/",
        "/app/WebUniswapContext",
        "/features/Liquidity/Create/"
      ],
      "importPrefixes": ["~/features/Swap/", "features/Swap/"],
      "bareModuleSources": ["~/features/Swap", "features/Swap"],
      "message": "The Swap feature may only be imported from pages/Swap/, pages/TokenDetails/, pages/Landing/, app/WebUniswapContext, features/Liquidity/Create/, or from within features/Swap/."
    },
    {
      "id": "explore-feature",
      "mode": "importerAllowlist",
      "importerInternalPathMarkers": ["/features/Explore/"],
      "allowedImporterPathMarkers": [
        "/pages/AddLiquidity/",
        "/pages/Explore/",
        "/pages/Landing/",
        "/pages/Launches/",
        "/pages/PoolDetails/",
        "/pages/Positions/",
        "/pages/TokenDetails/",
        "/features/Toucan/"
      ],
      "importPrefixes": ["~/features/Explore/", "features/Explore/"],
      "bareModuleSources": ["~/features/Explore", "features/Explore"],
      "message": "The Explore feature may only be imported from pages/AddLiquidity/, pages/Explore/, pages/Landing/, pages/Launches/, pages/PoolDetails/, pages/Positions/, pages/TokenDetails/, features/Toucan/ or from within features/Explore/."
    },
    {
      "id": "swap-ui-views",
      "mode": "importerDenylist",
      "deniedImporterPathMarkers": [["/features/transactions/swap/", "/views/"]],
      "importPrefixes": [
        "uniswap/src/features/telemetry",
        "utilities/src/telemetry",
        "uniswap/src/components/modals",
        "uniswap/src/features/transactions/swap/stores/",
        "uniswap/src/features/transactions/swap/form/stores/",
        "uniswap/src/features/transactions/swap/review/stores/",
        "uniswap/src/features/transactions/swap/plan/",
        "uniswap/src/features/transactions/components/settings/stores",
        "uniswap/src/features/transactions/components/TransactionModal/TransactionModalContext",
        "uniswap/src/contexts/UniswapContext",
        "@universe/gating/",
        "@tanstack/react-query"
      ],
      "bareModuleSources": ["@universe/gating", "@universe/compliance", "react-redux", "redux"],
      "message": "Swap views (files under a views/ directory in the swap tree) are presentational: data in via props, actions out via callbacks. No store reads, analytics, feature flags, data fetching, or modal shells; keep those in the adapter and pass the result down as props. See scripts/swap-ui/POLICIES.md."
    },
    {
      "id": "swap-ui-package",
      "mode": "importerDenylist",
      "deniedImporterPathMarkers": ["/packages/swap-ui/src/"],
      "importPrefixes": [
        "uniswap/src",
        "ui/src",
        "wallet/src",
        "utilities/src/telemetry",
        "@universe/gating/",
        "@tanstack/react-query",
        "@universe/environment",
        "zustand/"
      ],
      "bareModuleSources": [
        "ui/src",
        "@universe/gating",
        "@universe/compliance",
        "@universe/environment",
        "react-redux",
        "redux",
        "@tanstack/react-query",
        "zustand"
      ],
      "message": "@universe/swap-ui is presentational: nothing from uniswap/src, ui/src, wallet/src, gating, telemetry, redux, zustand, react-query or platform constants, including type imports. Data in via props, actions out via callbacks; the adapter in packages/uniswap does the rest. See packages/swap-ui/CLAUDE.md."
    },
    {
      "id": "web-state-import-denylist",
      "mode": "importerDenylist",
      "deniedImporterPathMarkers": ["/apps/web/src/state/"],
      "importPrefixes": ["~/features/", "features/", "~/components/", "components/"],
      "bareModuleSources": ["~/features", "features", "~/components", "components"],
      "message": "apps/web `src/state` must not import from `~/features/` or `~/components/`"
    }
  ]
}
