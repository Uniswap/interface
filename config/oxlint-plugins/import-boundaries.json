{
  "boundaries": [
    {
      "id": "swap-ui-views",
      "mode": "importerDenylist",
      "deniedImporterPathMarkers": [["/features/transactions/swap/", "/views/"]],
      "importPrefixes": [
        "uniswap/src/features/telemetry",
        "utilities/src/telemetry",
        "uniswap/src/components/modals",
        "uniswap/src/features/transactions/swap/stores/",
        "uniswap/src/features/transactions/swap/form/stores/",
        "uniswap/src/features/transactions/swap/review/stores/",
        "uniswap/src/features/transactions/swap/plan/",
        "uniswap/src/features/transactions/components/settings/stores",
        "uniswap/src/features/transactions/components/TransactionModal/TransactionModalContext",
        "uniswap/src/contexts/UniswapContext",
        "@universe/gating/",
        "@tanstack/react-query"
      ],
      "bareModuleSources": ["@universe/gating", "@universe/compliance", "react-redux", "redux"],
      "message": "Swap views (files under a views/ directory in the swap tree) are presentational: data in via props, actions out via callbacks. No store reads, analytics, feature flags, data fetching, or modal shells; keep those in the adapter and pass the result down as props. See scripts/transactions-ui/POLICIES.md."
    },
    {
      "id": "transactions-ui-package",
      "mode": "importerDenylist",
      "deniedImporterPathMarkers": ["/packages/transactions-ui/src/"],
      "importPrefixes": [
        "uniswap/src",
        "ui/src",
        "wallet/src",
        "utilities/src/telemetry",
        "@universe/gating/",
        "@tanstack/react-query",
        "@universe/environment",
        "zustand/"
      ],
      "bareModuleSources": [
        "ui/src",
        "@universe/gating",
        "@universe/compliance",
        "@universe/environment",
        "react-redux",
        "redux",
        "@tanstack/react-query",
        "zustand"
      ],
      "message": "@universe/transactions-ui is presentational: nothing from uniswap/src, ui/src, wallet/src, gating, telemetry, redux, zustand, react-query or platform constants, including type imports. Data in via props, actions out via callbacks; the adapter in packages/uniswap does the rest. See packages/transactions-ui/CLAUDE.md."
    },
    {
      "id": "transactions-ui-common",
      "mode": "importerDenylist",
      "deniedImporterPathMarkers": ["/packages/transactions-ui/src/common/"],
      "importPrefixes": [
        "@universe/transactions-ui/src/swap/",
        "@universe/transactions-ui/src/lp/",
        "@universe/transactions-ui/src/send/",
        "@universe/transactions-ui/src/margin/"
      ],
      "bareModuleSources": [],
      "message": "transactions-ui common/ is shared by several products, so it imports nothing from a product folder (swap/, lp/, send/, margin/). Move what both need into common/. See packages/transactions-ui/CLAUDE.md."
    },
    {
      "id": "transactions-ui-swap",
      "mode": "importerDenylist",
      "deniedImporterPathMarkers": ["/packages/transactions-ui/src/swap/"],
      "importPrefixes": [
        "@universe/transactions-ui/src/lp/",
        "@universe/transactions-ui/src/send/",
        "@universe/transactions-ui/src/margin/"
      ],
      "bareModuleSources": [],
      "message": "transactions-ui product folders never import each other. When a second product needs a view, move it into common/. See packages/transactions-ui/CLAUDE.md."
    },
    {
      "id": "web-state-import-denylist",
      "mode": "importerDenylist",
      "deniedImporterPathMarkers": ["/apps/web/src/state/"],
      "importPrefixes": [
        "~/features/",
        "features/",
        "~/components/",
        "components/",
        "~/hooks/",
        "hooks/",
        "~/app/",
        "app/",
        "~/pages/",
        "pages/"
      ],
      "bareModuleSources": [
        "~/features",
        "features",
        "~/components",
        "components",
        "~/hooks",
        "hooks",
        "~/app",
        "app",
        "~/pages",
        "pages"
      ],
      "message": "apps/web `src/state` must not import from `~/pages/`, `~/features/`, `~/components/`, `~/hooks/` or `~/app/`. React hooks that state code needs belong in `state/` or `connection/`."
    },
    {
      "id": "web-connection-import-denylist",
      "mode": "importerDenylist",
      "deniedImporterPathMarkers": ["/apps/web/src/connection/"],
      "importPrefixes": [
        "~/pages/",
        "pages/",
        "~/features/",
        "features/",
        "~/components/",
        "components/",
        "~/hooks/",
        "hooks/",
        "~/state/",
        "state/",
        "~/app/",
        "app/"
      ],
      "bareModuleSources": [
        "~/pages",
        "pages",
        "~/features",
        "features",
        "~/components",
        "components",
        "~/hooks",
        "hooks",
        "~/state",
        "state",
        "~/app",
        "app"
      ],
      "message": "apps/web `src/connection` is the wallet and chain plumbing layer: it may import `utils`, `constants`, `types` and packages, but not `~/pages/`, `~/features/`, `~/components/`, `~/hooks/`, `~/state/` or `~/app/`."
    },
    {
      "id": "web-types-constants-import-denylist",
      "mode": "importerDenylist",
      "deniedImporterPathMarkers": ["/apps/web/src/types/", "/apps/web/src/constants/"],
      "importPrefixes": [
        "~/pages/",
        "pages/",
        "~/features/",
        "features/",
        "~/components/",
        "components/",
        "~/state/",
        "state/",
        "~/hooks/",
        "hooks/",
        "~/utils/",
        "utils/",
        "~/app/",
        "app/",
        "~/lib/",
        "lib/",
        "~/data/",
        "data/",
        "~/connection/",
        "connection/",
        "~/theme/",
        "theme/"
      ],
      "bareModuleSources": [
        "~/pages",
        "pages",
        "~/features",
        "features",
        "~/components",
        "components",
        "~/state",
        "state",
        "~/hooks",
        "hooks",
        "~/utils",
        "utils",
        "~/app",
        "app",
        "~/lib",
        "lib",
        "~/data",
        "data",
        "~/connection",
        "connection",
        "~/theme",
        "theme"
      ],
      "message": "apps/web `src/types` and `src/constants` are the bottom layer: they may import each other and packages, but not `~/pages/`, `~/features/`, `~/components/`, `~/state/`, `~/hooks/`, `~/utils/`, `~/app/`, `~/lib/`, `~/data/`, `~/connection/` or `~/theme/`."
    },
    {
      "id": "web-utils-import-denylist",
      "mode": "importerDenylist",
      "deniedImporterPathMarkers": ["/apps/web/src/utils/"],
      "importPrefixes": [
        "~/pages/",
        "pages/",
        "~/features/",
        "features/",
        "~/components/",
        "components/",
        "~/state/",
        "state/",
        "~/hooks/",
        "hooks/",
        "~/app/",
        "app/"
      ],
      "bareModuleSources": [
        "~/pages",
        "pages",
        "~/features",
        "features",
        "~/components",
        "components",
        "~/state",
        "state",
        "~/hooks",
        "hooks",
        "~/app",
        "app"
      ],
      "message": "apps/web `src/utils` may import `utils`, `constants`, `types`, `lib` and packages, but not `~/pages/`, `~/features/`, `~/components/`, `~/state/`, `~/hooks/` or `~/app/`. Move the shared piece down rather than importing up."
    },
    {
      "id": "web-hooks-import-denylist",
      "mode": "importerDenylist",
      "deniedImporterPathMarkers": ["/apps/web/src/hooks/"],
      "importPrefixes": [
        "~/pages/",
        "pages/",
        "~/features/",
        "features/",
        "~/components/",
        "components/",
        "~/app/",
        "app/"
      ],
      "bareModuleSources": ["~/pages", "pages", "~/features", "features", "~/components", "components", "~/app", "app"],
      "message": "apps/web `src/hooks` may import `state`, `connection`, `utils`, `constants`, `types` and packages, but not `~/pages/`, `~/features/`, `~/components/` or `~/app/`. A hook that needs those belongs next to its consumer."
    },
    {
      "id": "web-components-import-denylist",
      "mode": "importerDenylist",
      "deniedImporterPathMarkers": ["/apps/web/src/components/"],
      "importPrefixes": ["~/pages/", "pages/", "~/features/", "features/", "~/app/", "app/"],
      "bareModuleSources": ["~/pages", "pages", "~/features", "features", "~/app", "app"],
      "message": "apps/web `src/components` is shared UI: it may not import `~/pages/`, `~/features/` or `~/app/`. Move the component into the page or feature that uses it, or move the piece it needs down to a base layer."
    },
    {
      "id": "web-features-import-denylist",
      "mode": "importerDenylist",
      "deniedImporterPathMarkers": ["/apps/web/src/features/"],
      "importPrefixes": ["~/pages/", "pages/", "~/app/", "app/"],
      "bareModuleSources": ["~/pages", "pages", "~/app", "app"],
      "message": "apps/web `src/features` is shared domain code: it may not import `~/pages/` or `~/app/`. Move the piece the feature needs out of the page into the feature or a base layer, or move the code that needs the page into that page."
    },
    {
      "id": "web-app-import-denylist",
      "mode": "importerDenylist",
      "deniedImporterPathMarkers": [
        "/apps/web/src/pages/",
        "/apps/web/src/features/",
        "/apps/web/src/components/",
        "/apps/web/src/state/",
        "/apps/web/src/hooks/",
        "/apps/web/src/utils/",
        "/apps/web/src/types/",
        "/apps/web/src/constants/",
        "/apps/web/src/connection/",
        "/apps/web/src/lib/",
        "/apps/web/src/data/",
        "/apps/web/src/theme/",
        "/apps/web/src/chains/",
        "/apps/web/src/rpc/",
        "/apps/web/src/sessions/",
        "/apps/web/src/shared-cloud/",
        "/apps/web/src/notification-service/",
        "/apps/web/src/tracing/",
        "/apps/web/src/featureFlags/",
        "/apps/web/src/dev/",
        "/apps/web/src/i18n/"
      ],
      "importPrefixes": ["~/app/", "app/"],
      "bareModuleSources": ["~/app", "app"],
      "message": "`~/app/` is the app shell and only `App.tsx`, `index.tsx` and `app/` itself may import it. Move shared constants or components down to `constants/` or `components/`."
    },
    {
      "id": "web-features-sibling-isolation",
      "mode": "siblingIsolation",
      "importerRootMarker": "/apps/web/src/features/",
      "importPrefixes": ["~/features/", "features/"],
      "bareModuleSources": [],
      "allowedSiblings": ["wallet"],
      "message": "A feature may only import from its own folder or from `features/wallet/`. Move shared code down to `components/`, `hooks/`, `utils/` or `state/`, or pass it in from the page."
    }
  ]
}
