{
  "extends": "../../config/tsconfig/app.json",
  "include": ["src/**/*.ts", "src/**/*.tsx", "src/**/*.json", "src/global.d.ts"],
  // Carve-out, not a fix. The recipes tests reach mycelium by relative import,
  // whose TS6307 no project reference can fix without a tailwind → mycelium
  // cycle.
  "exclude": ["src/recipes/**/*.test.ts", "src/recipes/**/*.test.tsx"],
  "compilerOptions": {
    "noEmit": false,
    "emitDeclarationOnly": true,
    "types": ["node", "vitest/globals"],
    "paths": {}
  },
  "references": [
    {
      "path": "../../config/vitest-presets"
    },
    {
      "path": "../environment"
    }
  ]
}
