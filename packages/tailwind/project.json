{
  "name": "@universe/tailwind",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/tailwind/src",
  "projectType": "library",
  "tags": ["scope:tailwind", "type:lib"],
  "targets": {
    "test": {
      "command": "vitest run --passWithNoTests",
      "options": {
        "cwd": "{projectRoot}"
      },
      "// TODO": "Drop the mycelium glob once the recipes tests (which import mycelium by relative path) move into mycelium.",
      "inputs": [
        "sourceFiles",
        "^production",
        "{projectRoot}/**/*.test.*",
        "{projectRoot}/**/*.spec.*",
        "{workspaceRoot}/packages/mycelium/src/**"
      ]
    },
    "typecheck": {},
    "typecheck:tsc": {},
    "typecheck:tsgo": {},
    "format": {},
    "format:check": {},
    "lint:oxlint": {
      "dependsOn": ["prepare"]
    },
    "lint:oxlint:fix": {},
    "lint:oxlint:fast": {},
    "lint": {},
    "lint:fix": {},
    "check": {},
    "check:fast": {},
    "check:deps:usage": {}
  }
}
