{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // Deliberately non-composite and referenced by no project: this program
    // typechecks the tests the composite tsconfig.json excludes, so their
    // imports never become project references. tokens.parity.test.ts reaches
    // ui/src source through the `ui` workspace link in node_modules (the
    // neighbor clears the base `paths` map) — full type coverage without a
    // mycelium -> ui reference edge (INFRA-3295).
    "composite": false,
    // No emit, so the inherited incremental buildinfo buys nothing — and a
    // stale one replays old diagnostics after a config change (observed with
    // tsc 7.0.2 when this program's `types` changed).
    "incremental": false,
    "noEmit": true,
    "emitDeclarationOnly": false,
    "types": ["node", "chrome"],
    // Foreign sources (ui/src and its transitive imports) compile under this
    // program's flags and would report their own projects' diagnostics.
    "noPropertyAccessFromIndexSignature": false,
    "typeRoots": ["../../node_modules/@types"]
  },
  // `files` (not `include`): a renamed or moved test is a hard TS6053 error
  // instead of silently dropping out of the program.
  "files": [
    "src/tokens.parity.test.ts",
    "src/scripts/text-compat-tokens.test.ts",
    "src/ui-icon-assignability.test.ts",
    "src/unicon/address-alias.test.tsx",
    "src/unicon/legacy-drift.test.ts",
    "src/global.d.ts",
    "../ui/src/env.d.ts"
  ],
  // Clear the inherited base `include` (src/**/*) — this program is exactly
  // the `files` above.
  "include": [],
  "references": []
}
