    "build:icons:missing": "nx build:icons:missing @universe/mycelium",
    "typecheck": "nx typecheck @universe/mycelium",
    "check": "nx check @universe/mycelium",
    "check:fast": "nx check:fast @universe/mycelium",
    "check:deps:usage": "nx check:deps:usage @universe/mycelium",
    "format": "nx run @universe/mycelium:format",
    "format:check": "nx run @universe/mycelium:format:check",
    "lint": "nx lint @universe/mycelium",
    "lint:fix": "nx lint:fix @universe/mycelium",
    "test": "nx test @universe/mycelium"
  },
  "nx": {
    "includedScripts": []
  }
}
