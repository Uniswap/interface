{
  "name": "@universe/mycelium",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/mycelium/src",
  "projectType": "library",
  "tags": ["scope:mycelium", "type:lib"],
  "targets": {
    "build:icons": {
      "command": "bun run ./src/scripts/componentize-icons.ts --silent && oxfmt --threads=2 -c $NX_WORKSPACE_ROOT/.oxfmtrc.json src/components/icons",
      "options": {
        "cwd": "{projectRoot}"
      },
      "cache": true,
      "inputs": [
        "lintConfig",
        "{projectRoot}/src/scripts/componentize-icons.ts",
        "{workspaceRoot}/packages/ui/src/assets/icons/**",
        "{projectRoot}/src/components/icons/**",
        "ciCacheBust"
      ],
      "outputs": ["{projectRoot}/src/components/icons/**"]
    },
    "build:icons:missing": {
      "command": "bun run ./src/scripts/componentize-icons.ts --skip-existing --silent && oxfmt --threads=4 -c $NX_WORKSPACE_ROOT/.oxfmtrc.json src/components/icons",
      "options": {
        "cwd": "{projectRoot}"
      },
      "cache": true,
      "inputs": [
        "{projectRoot}/src/scripts/componentize-icons.ts",
        "{workspaceRoot}/packages/ui/src/assets/icons/**",
        "ciCacheBust"
      ],
      "outputs": ["{projectRoot}/src/components/icons/**"]
    },
    "typecheck": {},
    "format": {},
    "format:check": {},
    "lint:oxlint": {},
    "lint:oxlint:fix": {},
    "lint:oxlint:fast": {},
    "lint": {},
    "lint:fix": {},
    "check": {},
    "check:fast": {},
    "check:deps:usage": {},
    "test": {
      "command": "vitest run",
      "options": {
        "cwd": "{projectRoot}"
      }
    }
  }
}
