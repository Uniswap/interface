{
  "extends": "../../config/tsconfig/app.json",
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.json",
    "src/global.d.ts",
    ".storybook/*.ts",
    ".storybook/*.tsx",
    ".storybook/*.mts"
  ],
  "compilerOptions": {
    "noEmit": false,
    "emitDeclarationOnly": true,
    // Platform-leg tests import the platformless base file by exact path
    // (`./Shimmer.tsx`) because this package's vitest resolver picks `.web.*`
    // first; without this the specifier is a compile error.
    "allowImportingTsExtensions": true,
    "types": ["node"],
    "paths": {}
  },
  "references": [
    {
      "path": "../tailwind"
    },
    {
      "path": "../environment"
    },
    {
      "path": "../logger"
    },
    {
      "path": "../utilities"
    },
    {
      "path": "../config"
    },
    {
      "path": "../../config/vitest-presets"
    },
    {
      "path": "../../config/storybook"
    }
  ]
}
