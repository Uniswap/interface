# HookSwap gateway-schema adapter — service env (copy to .env, DO NOT commit real values)
# The adapter serves the interface's gateway GraphQL schema. Subgraph-backed ops (pools/tokens/
# prices) read the per-chain subgraph URLs below; everything else is proxied to UPSTREAM_GATEWAY_URL.

# --- HTTP host ---
PORT=4000
# GraphQL path the adapter serves. The interface's AWS_API_ENDPOINT ends in /v1/graphql, so keep this.
GRAPHQL_ENDPOINT=/v1/graphql
# Origin allowed to call this adapter from the browser. Set to the interface origin in prod,
# e.g. https://hookswap.org  (use http://localhost:3000 for local interface dev). "*" allows any.
CORS_ALLOW_ORIGIN=http://localhost:3000

# --- Passthrough proxy target (unimplemented ops: balances, NFTs, token projects, v2/v4) ---
# The REAL Uniswap gateway. Any operation this adapter does not serve from a subgraph is forwarded
# here verbatim and its response returned unchanged. If unset, unimplemented ops return a GraphQL
# error (NEVER fabricated data).
UPSTREAM_GATEWAY_URL=https://beta.gateway.uniswap.org/v1/graphql
# Optional: Uniswap gateway origin/api-key headers to send upstream (mirror the interface's headers
# if the upstream requires them). Comma-separated k:v pairs, or leave blank.
# UPSTREAM_HEADERS=origin:https://app.uniswap.org

# --- Per-chain v3-subgraph GraphQL URLs (graph-node on the same VPS, see v3-subgraph/hookswap/SELF-HOST.md) ---
# One graph-node serves all chains; each chain = its own subgraph deployment + URL.
# Pattern (from SELF-HOST.md §4):  http://graph-node:8000/subgraphs/name/hookswap-v3-<chain>
# On a single VPS with docker-compose, "graph-node" is the service hostname on the shared network.
SUBGRAPH_URL_11155111=http://graph-node:8000/subgraphs/name/hookswap-v3-sepolia    # Sepolia
SUBGRAPH_URL_57073=http://graph-node:8000/subgraphs/name/hookswap-v3-ink           # Ink
SUBGRAPH_URL_4326=http://graph-node:8000/subgraphs/name/hookswap-v3-megaeth        # MegaETH
SUBGRAPH_URL_4663=http://graph-node:8000/subgraphs/name/hookswap-v3-robinhood      # Robinhood
SUBGRAPH_URL_196=http://graph-node:8000/subgraphs/name/hookswap-v3-xlayer          # XLayer
SUBGRAPH_URL_999=http://graph-node:8000/subgraphs/name/hookswap-v3-hyperevm        # HyperEVM
SUBGRAPH_URL_4217=http://graph-node:8000/subgraphs/name/hookswap-v3-tempo          # Tempo
