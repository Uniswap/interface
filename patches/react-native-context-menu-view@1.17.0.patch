+// Close the context menu when the app is backgrounded.
+- (void)startObservingBackground {
+    if (_observingBackground) {
+        return;
+    }
+    _observingBackground = YES;
+    [[NSNotificationCenter defaultCenter] addObserver:self
+                                             selector:@selector(dismissOpenContextMenu)
+                                                 name:UIApplicationDidEnterBackgroundNotification
+                                               object:nil];
+}
+
+- (void)stopObservingBackground {
+    if (!_observingBackground) {
+        return;
+    }
+    _observingBackground = NO;
+    [[NSNotificationCenter defaultCenter] removeObserver:self
+                                                    name:UIApplicationDidEnterBackgroundNotification
+                                                  object:nil];
+}
+
+- (void)dismissOpenContextMenu {
