+      [
+        ['a', 'Item a'],
+        ['b', 'Item b']
+      ],
+      renderer
+    );
+
+    const nodeA = store.getNode('a');
+    const nodeB = store.getNode('b');
+
+    let notifiedA = 0;
+    let notifiedB = 0;
+    store.subscribeItem('a', () => {
+      notifiedA += 1;
+    });
+    store.subscribeItem('b', () => {
+      notifiedB += 1;
+    });
+
+    store.update(
+      [
+        ['b', 'Item b'],
+        ['a', 'Item a']
+      ],
+      renderer
+    );
+
+    expect(notifiedA).toBe(0);
+    expect(notifiedB).toBe(0);
+    expect(store.getNode('a')).toBe(nodeA);
+    expect(store.getNode('b')).toBe(nodeB);
+    expect(store.getKeys()).toEqual(['b', 'a']);
+  });
 });
