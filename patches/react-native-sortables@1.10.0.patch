+
+const resolveAnyDimension = (dimension: ItemSizes): null | number => {
+  'worklet';
+  if (!dimension) {
+    return null;
+  }
+  if (typeof dimension === 'number') {
+    return dimension;
+  }
+  let result: null | number = null;
+  for (const key in dimension) {
+    const size = dimension[key];
+    if (size !== undefined && (result === null || size > result)) {
+      result = size;
+    }
+  }
+  return result;
+};
+
+/**
+ * Like `getItemDimensions`, but substitutes a sibling's size for a missing
+ * measurement. Used on the drag activation path, where returning null means the
+ * item can never be lifted again — a much worse outcome than starting the drag
+ * with an approximate size that the next layout pass corrects.
+ */
+export const getItemDimensionsWithFallback = (
+  key: string,
+  itemWidths: ItemSizes,
+  itemHeights: ItemSizes
+): Dimensions | null => {
+  'worklet';
+  const itemWidth =
+    resolveDimension(itemWidths, key) ?? resolveAnyDimension(itemWidths);
+  const itemHeight =
+    resolveDimension(itemHeights, key) ?? resolveAnyDimension(itemHeights);
+
+  if (itemWidth === null || itemHeight === null) {
+    return null;
+  }
+
+  return { height: itemHeight, width: itemWidth };
+};
